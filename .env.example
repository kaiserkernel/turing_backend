# ---------------------------------------------------------------
# Turing Vision Open API
# ---------------------------------------------------------------
# Vision Portal -> Settings -> Org Settings -> Third-party Access Token
TURING_ACCESS_TOKEN=paste_your_token_here
# 7759c0fed8e54983a1900c46008193bd3cb4fbdf0013
TURING_BASE_URL=https://app.turingvideo.com

# Optional. Restricts which Turing sites this service exposes.
# Leave blank to expose every site the token can reach.
TURING_SITE_IDS=

# ---------------------------------------------------------------
# MyGeotab
# ---------------------------------------------------------------
# Hostnames accepted when verifying a session. Wildcards allowed.
GEOTAB_ALLOWED_SERVERS=my.geotab.com,*.geotab.com

# Seconds a verified session is trusted before re-checking.
GEOTAB_SESSION_TTL=300

# ---------------------------------------------------------------
# Server
# ---------------------------------------------------------------
# Where the Add-In is hosted. Blank allows any origin (development only).
CORS_ORIGINS=

PORT=3000
NODE_ENV=development
LOG_LEVEL=info
